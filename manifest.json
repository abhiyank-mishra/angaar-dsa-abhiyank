{
  "manifest_version": 3,
  "name": "Angaar Toolkit Pro (Leaderboard + GitHub Sync + Backup)",
  "version": "2.3.0",
  "description": "Problem of the Day Tracker, Contests & Arena, 600+ Leaderboard Expander, Study Notes PDFs, Grader Driver Code, and GitHub Auto-Sync for The Angaar Batch.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Angaar Toolkit Pro"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://theangaarbatch.in/*",
    "https://api.github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://theangaarbatch.in/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://theangaarbatch.in/*"
      ],
      "js": [
        "injected.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js"
      ],
      "matches": [
        "https://theangaarbatch.in/*"
      ]
    }
  ]
}